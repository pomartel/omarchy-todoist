#!/usr/bin/env python3
"""Exercise real panel pointer handlers offscreen with synthetic data and no network."""
import os
from pathlib import Path
import re
import shutil
import subprocess
import tempfile

repo = Path(__file__).resolve().parent.parent
with tempfile.TemporaryDirectory(prefix='todoist-drag-') as temporary:
    directory = Path(temporary)
    shell = Path(os.environ.get('OMARCHY_PATH', '/usr/share/omarchy')) / 'shell'
    for name in ('Commons', 'Ui'):
        (directory / name).symlink_to(shell / name)
    plugin = directory / 'plugin'
    plugin.mkdir()
    shutil.copytree(repo / "omatasks", plugin / "omatasks")
    for source in list(repo.glob('*.qml')) + list(repo.glob('*.js')):
        shutil.copy(source, plugin / source.name)
    source = (plugin / 'Panel.qml').read_text()
    source = source.replace('KeyboardPanel {', 'TestPanel {')
    source = source.replace('Component.onCompleted: ensureStateDir()', '')
    source = source.replace('homeDir + "/.local/state/omarchy/omarchy-todoist"', '"' + temporary + '/state"')
    source = re.sub(r'  function runAuthedCurl\(proc, command\) \{.*?^  }',
        '  function runAuthedCurl(proc, command) { captured = captured.concat([command]) }', source, flags=re.S|re.M)
    source = re.sub(r'  function refresh\(\) \{.*?^  }', '  function refresh() {}', source, flags=re.S|re.M)
    source = source.replace('  property var tasks: []', '  property var captured: []\n  property var tasks: []')
    (plugin / 'Panel.qml').write_text(source)
    (plugin / 'TestPanel.qml').write_text('''import QtQuick
Item {
  anchors.fill: parent
  property var anchorItem
  property var owner
  property var bar
  property bool open
  property bool centerOnBar
  property var focusTarget
  property real contentWidth
  property real contentHeight
  property real padding
  function fittedContentWidth(value) { return value }
  function fittedContentHeight(value) { return value }
}
''')
    fixture = (repo / 'tests/drag.qml').read_text()
    width = max(300, min(1000, int(os.environ.get('TODOIST_TEST_WIDTH', '400'))))
    (directory / 'shell.qml').write_text(fixture.replace('implicitWidth: 400', f'implicitWidth: {width}'))
    result = subprocess.run(['quickshell', '-p', temporary, '--no-color'],
        env={**os.environ, 'QT_QPA_PLATFORM': 'offscreen'}, capture_output=True, text=True, timeout=45)
    output = result.stdout + result.stderr
    print(output)
    if not re.search(r'DRAG UI RESULTS \d+ passed 0 failed', output) or re.search(r'ReferenceError|TypeError|Unable to assign|Binding loop', output):
        raise SystemExit(1)
